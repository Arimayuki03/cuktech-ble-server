# CUKTECH BLE Server Configuration
# Copy this file to config.yaml and fill in your values

ble:
  mac: "XX:XX:XX:XX:XX:XX"
  token: ""
  ble_key: ""
  scan_timeout: 15  # BLE 扫描超时（秒），弱信号环境可增大

mqtt:
  # 设置为 true 启用 MQTT（用于 Home Assistant 集成），false 则作为独立 web 服务运行
  # 也可以通过环境变量 MQTT_ENABLED=1 启用
  enabled: true
  host: "localhost"
  port: 1883
  username: ""
  password: ""
  keepalive: 60
  topic_prefix: "cuktech/charger"

server:
  host: "0.0.0.0"
  port: 8199       # Win 系统可能占用 8199 端口，改为 18199
  command_timeout: 20.0
  reconnect_base_delay: 1.0       # 初始重连延迟（秒）
  reconnect_max_delay: 300.0      # 最大重连延迟（秒）
  settings_refresh_interval: 10.0 # 端口状态刷新间隔（秒）
  log_level: "info"               # debug, info, warning, error
  history_retention_days: 2       # 保留最近 N 天的历史数据
  history_db_path: ""             # SQLite 数据库文件路径

bemfa:
  enabled: false   # 是否启用巴法云，接入小爱同学/小度音箱
  uid: ""          # 巴法云控制台的私钥
  name_c1: "C口1开关"       # 巴法云设备显示名称（可自定义）
  name_c2: "C口2开关"
  name_c3: "C口3开关"
  name_a: "USB-A开关"
  name_ble: "蓝牙开关"
